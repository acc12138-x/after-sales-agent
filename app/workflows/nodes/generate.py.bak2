# 问题类型识别
STEP_KEYWORDS = ["排查", "处理", "怎么办", "怎么修", "维修", "操作", "步骤", "流程", "怎么解决", "如何处理"]
CAUSE_KEYWORDS = ["原因", "为什么", "怎么回事", "为啥", "为什么会", "什么导致"]
PHENOMENON_KEYWORDS = ["现象", "表现", "会怎样", "会怎么样", "会有什么", "什么后果", "后果", "征兆", "症状"]


def _pick_prompt(question: str) -> str:
    """根据问题类型选 prompt 模板。"""
    q = question or ""
    # 优先级：原因 > 现象 > 步骤 > 通用
    for kw in CAUSE_KEYWORDS:
        if kw in q:
            return PROMPT_CAUSE
    for kw in PHENOMENON_KEYWORDS:
        if kw in q:
            return PROMPT_PHENOMENON
    for kw in STEP_KEYWORDS:
        if kw in q:
            return PROMPT_STEP
    return PROMPT_GENERIC


def format_context(chunks: List[Dict], max_chunks: int = 5) -> str:
    """把候选 chunks 拼成上下文。关键：
    - 去重（父块/子块内容高度相似时只保留一个）
    - 最多 5 条（原为 3，导致"排查步骤"被挤掉）
    - 去 heading 前缀
    """
    lines = []
    seen_keys = set()
    for c in chunks:
        if len(lines) >= max_chunks:
            break
        text = c.get("text", "").strip().replace("\n", " ")
        # 去 [xxx] 前缀
        for _ in range(3):
            new = PREFIX_RE.sub("", text).strip()
            if new == text:
                break
            text = new
        # 去 "xxx > yyy" 前缀
        for tw in TITLE_WORDS:
            if tw in text and ">" in text:
                idx = text.find(tw)
                gt_idx = text.rfind(">", 0, idx)
                if gt_idx > -1:
                    text = text[idx + len(tw):].strip()
                    break
        # 去重：前 60 字符相同视为重复
        key = text[:60]
        if key in seen_keys:
            continue
        seen_keys.add(key)
        i = len(lines) + 1
        lines.append(f"[{i}] {text[:220]}")
    return "\n".join(lines)


def _fallback_from_chunks(chunks: List[Dict]) -> str:
    if not chunks:
        return "暂无相关依据，建议转人工。"
    for c in chunks:
        text = c.get("text", "").strip().replace("\n", " ")
        for _ in range(3):
            new = PREFIX_RE.sub("", text).strip()
            if new == text:
                break
            text = new
        for tw in TITLE_WORDS:
            if tw in text and ">" in text:
                idx = text.find(tw)
                gt_idx = text.rfind(">", 0, idx)
                if gt_idx > -1:
                    text = text[idx + len(tw):].strip()
                    break
        if "排查" in text or "步骤" in text or "检查" in text:
            return f"{text[:150].rstrip()} [1]"
    text = chunks[0].get("text", "").strip().replace("\n", " ")
    return f"{text[:150].rstrip()} [1]"


def generate_node(state: AgentState) -> AgentState:
    chunks = state.get("retrieved", []) or []
    question = state.get("user_input", "")

    if not chunks or state.get("flow_status") == "rejected":
        return {
            **state,
            "answer": "抱歉，知识库中没有找到与您问题相关的内容。请补充更多信息，或回复「转人工」联系客服。",
            "citations": [],
            "flow_status": "rejected",
        }

    context = format_context(chunks, max_chunks=5)
    prompt = _pick_prompt(question).format(context=context, question=question)

    answer = ""
    try:
        resp = get_llm().invoke(prompt)
        raw = resp.content if hasattr(resp, "content") else str(resp)
        answer = clean_answer(raw)
    except Exception as e:
        answer = f"生成失败：{e}"

    if _is_refusal(answer):
        answer = clean_answer(_fallback_from_chunks(chunks))

    # 引用替换：[1] -> [doc-e102-v6]
    answer = _replace_citation_numbers(answer, chunks)

    citations = [
        {"index": i + 1, "chunk_id": c["chunk_id"], "source": c["metadata"].get("source", "")}
        for i, c in enumerate(chunks[:3])
    ]

    messages = state.get("messages", []) or []
    messages = messages + [{"role": "assistant", "content": answer}]

    return {
        **state,
        "answer": answer,
        "citations": citations,
        "messages": messages,
        "flow_status": "succeeded",
    }
