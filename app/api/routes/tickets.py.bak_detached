from __future__ import annotations
from datetime import datetime
from typing import Optional
from uuid import uuid4

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel
from sqlalchemy import select

from app.api.schemas.models import TicketCreateRequest, TicketResponse
from app.audit.logger import log as audit_log
from app.db.models.engineer import Engineer
from app.db.models.ticket import Ticket
from app.db.session import session_scope
from app.notify.notifier import send as notify


router = APIRouter(prefix="/tickets", tags=["tickets"])


class RejectRequest(BaseModel):
    reason: str = ""


class ResolveRequest(BaseModel):
    note: str = ""


def _pick_engineer(s, error_code: str, exclude_names: Optional[list] = None):
    """派单：技能 + 在线 + 负载未满 + 排除指定工程师。"""
    exclude_names = exclude_names or []
    rows = s.execute(select(Engineer).where(Engineer.status == "online")).scalars().all()

    candidates = [
        e for e in rows
        if e.current_load < e.max_load and e.name not in exclude_names
    ]

    if not candidates:
        return None

    # 技能匹配优先
    skilled = [e for e in candidates if error_code in e.skill_list]
    pool = skilled if skilled else candidates
    pool.sort(key=lambda x: (x.current_load, x.id))
    return pool[0]


def do_create_ticket(
    device_model: str,
    error_code: str,
    description: str = "",
    contact: str = "",
    address: str = "",
) -> dict:
    tid = f"T{uuid4().hex[:8].upper()}"

    with session_scope() as s:
        engineer = _pick_engineer(s, error_code)
        if engineer is None:
            raise HTTPException(status_code=503, detail="当前无可用工程师")

        t = Ticket(
            ticket_id=tid,
            status="assigned",
            assigned_to=engineer.name,
            assigned_engineer_id=engineer.id,
            device_model=device_model,
            error_code=error_code,
            description=description,
            contact=contact,
            address=address,
            created_at=datetime.utcnow(),
            assigned_at=datetime.utcnow(),
            assign_count=1,
        )
        s.add(t)
        engineer.current_load = (engineer.current_load or 0) + 1
        s.flush()

        result = t.to_dict()

    # 通知 + 审计（事务外）
    notify(
        target=engineer.name,
        event="ticket_assigned",
        title=f"新工单 {tid}",
        content=f"设备 {device_model} 故障码 {error_code}，请及时处理。",
    )
    audit_log(
        action="ticket.created",
        actor="system",
        target_type="ticket",
        target_id=tid,
        detail={"engineer": engineer.name, "error_code": error_code},
    )

    return result


@router.post("", response_model=TicketResponse)
async def create_ticket(req: TicketCreateRequest) -> TicketResponse:
    t = do_create_ticket(
        device_model=req.device_model,
        error_code=req.error_code,
        description=req.description,
        contact=req.contact,
        address=req.address,
    )
    return TicketResponse(
        ticket_id=t["ticket_id"],
        status=t["status"],
        assigned_to=t["assigned_to"],
        created_at=t["created_at"],
    )


@router.get("/{ticket_id}")
async def get_ticket(ticket_id: str):
    with session_scope() as s:
        t = s.get(Ticket, ticket_id)
        if t is None:
            raise HTTPException(status_code=404, detail="ticket not found")
        return t.to_dict()


@router.get("")
async def list_all_tickets(status: Optional[str] = None):
    with session_scope() as s:
        q = select(Ticket).order_by(Ticket.created_at.desc())
        if status:
            q = q.where(Ticket.status == status)
        rows = s.execute(q).scalars().all()
        items = [t.to_dict() for t in rows]
    return {"total": len(items), "items": items}


# ============ 状态机 ============
def _transition(ticket_id: str, new_status: str, extra: dict = None) -> dict:
    """状态变更核心逻辑。"""
    with session_scope() as s:
        t = s.get(Ticket, ticket_id)
        if t is None:
            raise HTTPException(status_code=404, detail="ticket not found")
        if not t.can_transition_to(new_status):
            raise HTTPException(
                status_code=400,
                detail=f"不允许从 {t.status} 流转到 {new_status}",
            )

        old_status = t.status
        t.status = new_status
        t.updated_at = datetime.utcnow()

        if extra:
            for k, v in extra.items():
                setattr(t, k, v)

        # 时间戳
        if new_status == "accepted":
            t.accepted_at = datetime.utcnow()
        elif new_status == "resolved":
            t.resolved_at = datetime.utcnow()
            # 负载 -1
            if t.assigned_engineer_id:
                eng = s.get(Engineer, t.assigned_engineer_id)
                if eng and eng.current_load > 0:
                    eng.current_load -= 1
        elif new_status == "closed":
            t.closed_at = datetime.utcnow()

        result = t.to_dict()
        result["_old_status"] = old_status

    # 审计 + 通知
    audit_log(
        action=f"ticket.{new_status}",
        actor="api",
        target_type="ticket",
        target_id=ticket_id,
        detail={"from": result["_old_status"], "to": new_status},
    )
    return result


@router.post("/{ticket_id}/accept")
async def accept_ticket(ticket_id: str):
    r = _transition(ticket_id, "accepted")
    notify(target=r["assigned_to"], event="ticket_accepted",
           title=f"工单 {ticket_id} 已接单")
    return r


@router.post("/{ticket_id}/reject")
async def reject_ticket(ticket_id: str, req: RejectRequest):
    """拒单 -> 重新派给其他工程师。"""
    with session_scope() as s:
        t = s.get(Ticket, ticket_id)
        if t is None:
            raise HTTPException(status_code=404, detail="ticket not found")
        if t.status not in ("assigned", "accepted", "in_progress"):
            raise HTTPException(status_code=400, detail=f"当前状态 {t.status} 不能拒单")

        old_engineer = t.assigned_to
        # 释放旧工程师负载
        if t.assigned_engineer_id:
            old_eng = s.get(Engineer, t.assigned_engineer_id)
            if old_eng and old_eng.current_load > 0:
                old_eng.current_load -= 1

        # 重新派单
        new_eng = _pick_engineer(s, t.error_code, exclude_names=[old_engineer])

        if new_eng is None:
            t.status = "rejected"
            t.reject_reason = req.reason
            result = t.to_dict()
            result["_old_status"] = "rejected_no_engineer"
        else:
            t.status = "assigned"
            t.assigned_to = new_eng.name
            t.assigned_engineer_id = new_eng.id
            t.reject_reason = req.reason
            t.assign_count = (t.assign_count or 0) + 1
            t.assigned_at = datetime.utcnow()
            new_eng.current_load += 1
            result = t.to_dict()
            result["_old_status"] = "reassigned"
            result["new_engineer"] = new_eng.name

    # 通知旧工程师 + 审计
    notify(target=old_engineer, event="ticket_rejected",
           title=f"工单 {ticket_id} 已拒单", content=req.reason or "无原因")
    if result.get("new_engineer"):
        notify(target=result["new_engineer"], event="ticket_assigned",
               title=f"新工单 {ticket_id}", content="请及时处理")
    audit_log(
        action="ticket.rejected",
        actor="api",
        target_type="ticket",
        target_id=ticket_id,
        detail={"reason": req.reason, "old_engineer": old_engineer},
    )
    return result


@router.post("/{ticket_id}/start")
async def start_ticket(ticket_id: str):
    r = _transition(ticket_id, "in_progress")
    notify(target=r["assigned_to"], event="ticket_in_progress",
           title=f"工单 {ticket_id} 开始处理")
    return r


@router.post("/{ticket_id}/resolve")
async def resolve_ticket(ticket_id: str, req: ResolveRequest):
    r = _transition(ticket_id, "resolved", extra={"resolved_note": req.note})
    notify(target=r["assigned_to"], event="ticket_resolved",
           title=f"工单 {ticket_id} 已解决")
    return r


@router.post("/{ticket_id}/close")
async def close_ticket(ticket_id: str):
    r = _transition(ticket_id, "closed")
    notify(target=r["assigned_to"], event="ticket_closed",
           title=f"工单 {ticket_id} 已关闭")
    return r


# ============ 审计 / 通知 查询 ============
@router.get("/{ticket_id}/audit")
async def get_ticket_audit(ticket_id: str, limit: int = 50):
    from app.db.models.audit_log import AuditLog
    with session_scope() as s:
        rows = s.execute(
            select(AuditLog)
            .where(AuditLog.target_id == ticket_id)
            .order_by(AuditLog.created_at.desc())
            .limit(limit)
        ).scalars().all()
        return {"items": [r.to_dict() for r in rows]}


@router.get("/{ticket_id}/notifications")
async def get_ticket_notifications(ticket_id: str, limit: int = 50):
    from app.db.models.notification import Notification
    with session_scope() as s:
        t = s.get(Ticket, ticket_id)
        if t is None:
            raise HTTPException(status_code=404, detail="ticket not found")
        rows = s.execute(
            select(Notification)
            .order_by(Notification.created_at.desc())
            .limit(limit)
        ).scalars().all()
        # 只返回与该工单相关的（简单过滤：content 或 title 包含 ticket_id）
        items = [r.to_dict() for r in rows
                 if ticket_id in (r.title or "") or ticket_id in (r.content or "")
                 or r.target == t.assigned_to]
        return {"items": items}
