# ============================================================
# Production 环境配置（Docker Compose）
# 注意：所有 host 用 Docker 内部服务名
# ============================================================

# ---------- 应用 ----------
APP_NAME=Enterprise After-Sales Knowledge Base Agent Platform
APP_ENV=production
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# ---------- LLM Provider（云端，填入真实 key）----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---------- Embedding Provider（云端，填入真实 key）----------
EMBEDDING_PROVIDER=dashscope_embedding
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=

# ---------- Ollama 原生（生产不用，保留兼容）----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5-1.5b:latest
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# ---------- Chroma 向量库（连 Docker 容器）----------
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- RAG 参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# ---------- Redis（Docker 内部）----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- MySQL（Docker 内部，容器间用 3306）----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=agent_password
MYSQL_DATABASE=after_sales_agent

# ---------- NO_PROXY ----------
NO_PROXY=127.0.0.1,localhost,::1,mysql,redis,chroma
no_proxy=127.0.0.1,localhost,::1,mysql,redis,chroma
