# ============================================================
# 生产环境配置模板
#
# 用法：
#   cp .env.production.example .env.production
#   然后填入真实值（.env.production 已被 .gitignore 排除，不会进仓库）
#
# 本模板针对「2GB 小内存 + 多项目共存」场景做了取舍：
#   DB_MODE=sqlite + CACHE_BACKEND=sqlite + CHROMA_MODE=embedded
#   → 不需要 MySQL / Redis / Chroma 三个容器，单实例内存约 400MB
# ============================================================

# ---------- 应用 ----------
APP_NAME=Enterprise Business Agent Platform
APP_ENV=production
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO

# ---------- LLM（云端 OpenAI 兼容接口）----------
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=

# ---------- Embedding ----------
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=

# ---------- Chroma 向量库（内嵌，免独立服务）----------
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- RAG 参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
MIN_RELEVANCE_SCORE=0.55

# ---------- 业务库：2GB 机器强烈建议 SQLite ----------
DB_MODE=sqlite
# 若坚持用 MySQL，注释掉上一行，启用下面几行（host 用 compose 里的服务名）
# DB_MODE=mysql
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=agent
# MYSQL_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=after_sales_agent

# ---------- 缓存：SQLite 即可，省掉一个 Redis 容器 ----------
CACHE_BACKEND=sqlite
# CACHE_BACKEND=redis
# REDIS_URL=redis://redis:6379/0

# ---------- OpenClaw 网关 ----------
# 注意：容器里的 127.0.0.1 是容器自己；若 OpenClaw 跑在宿主机，用 host.docker.internal
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18000
OPENCLAW_API_KEY=CHANGE_ME

# 飞书应用凭据（后端主动发通知用；open_id 必须由该应用签发）
OPENCLAW_FEISHU_APP_ID=
OPENCLAW_FEISHU_APP_SECRET=

# ---------- 飞书群 webhook（敏感，只放这里）----------
# ⚠️ 绝不要写进 app/config/feishu_routes.yaml —— 那个文件被 git 跟踪
FEISHU_WEBHOOK_ENGINEER_GROUP=
FEISHU_WEBHOOK_SUPERVISOR_GROUP=
FEISHU_WEBHOOK_SLA_GROUP=
FEISHU_WEBHOOK_CUSTOMER_CHANNEL=

# ---------- JWT ----------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=168

# ---------- 网络 ----------
NO_PROXY=127.0.0.1,localhost,::1,app,edge,host.docker.internal
no_proxy=127.0.0.1,localhost,::1,app,edge,host.docker.internal
