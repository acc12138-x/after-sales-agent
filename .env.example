# ============================================================
# 本地开发配置（Ollama 原生 + Chroma embedded）
# ============================================================

# ---------- 应用 ----------
APP_NAME=Enterprise Business Agent Platform
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ---------- LLM Provider ----------
# ollama_native / deepseek / dashscope_llm / moonshot / zhipu / openai
LLM_PROVIDER=ollama_native
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=modelscope.cn/Qwen/Qwen3-4B-GGUF:latest
LLM_API_KEY=

# ---------- Embedding Provider ----------
# ollama_native / dashscope_embedding / zhipu_embedding / openai_embedding
EMBEDDING_PROVIDER=ollama_native
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=

# ---------- Ollama 原生字段（ollama_native 模式读取）----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=modelscope.cn/Qwen/Qwen3-4B-GGUF:latest
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# ---------- Chroma 向量库 ----------
# embedded = 本地持久化目录 | http = 连 Chroma 服务
CHROMA_MODE=embedded
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- RAG 参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=agent
MYSQL_PASSWORD=agent_password
MYSQL_DATABASE=after_sales_agent

# ---------- NO_PROXY（避免代理拦截本地服务）----------
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# ---------- 相关性阈值 ----------
MIN_RELEVANCE_SCORE=0.55

# ========== OpenClaw 多渠道网关 ==========
# 后端不自己接渠道：它把 LangGraph 伪装成一个 OpenAI Provider，
# 由 OpenClaw 负责飞书/企微/钉钉的接入与会话控制。
# 详见 docs/09-openclaw-deployment.md
#
# ⚠️ OPENCLAW_ENABLED 只控制「启动时探活 + /health 上报」，不是集成总闸；
#    /v1/chat/completions 端点始终挂载，网关随时可以调进来。
#
# 本地调试指向本机网关；生产指向你服务器上的网关。
# 真实地址/密钥请只写在 .env / .env.production（已被 .gitignore 排除），
# 不要把公网地址或 API Key 提交进仓库。
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18000
OPENCLAW_API_KEY=local-rag-key
# 是否强制校验网关调用方带的 API Key
# /v1/* 与 /threads/* 是给 OpenClaw 调的（服务端到服务端），不能用登录 JWT。
# true 时网关必须在 Provider 里配好与上面一致的 Key，否则入站会收到 401；
# 网关侧还没配置好时可临时设 false。
OPENCLAW_REQUIRE_KEY=true

# 飞书应用凭据（后端主动发通知时使用）
# ⚠️ 飞书 open_id / chat_id 按应用隔离，必须与本应用的凭据一致，
#    否则发送时报 99992361 open_id cross app
OPENCLAW_FEISHU_APP_ID=
OPENCLAW_FEISHU_APP_SECRET=
