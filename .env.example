# ============================================================
# 本地开发配置（Ollama 原生 + Chroma embedded）
# ============================================================

# ---------- 应用 ----------
APP_NAME=Enterprise After-Sales Knowledge Base Agent Platform
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ---------- LLM Provider ----------
# ollama_native / deepseek / dashscope_llm / moonshot / zhipu / openai
LLM_PROVIDER=ollama_native
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=modelscope.cn/Qwen/Qwen3-4B-GGUF:latest
LLM_API_KEY=

# ---------- Embedding Provider ----------
# ollama_native / dashscope_embedding / zhipu_embedding / openai_embedding
EMBEDDING_PROVIDER=ollama_native
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=

# ---------- Ollama 原生字段（ollama_native 模式读取）----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=modelscope.cn/Qwen/Qwen3-4B-GGUF:latest
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# ---------- Chroma 向量库 ----------
# embedded = 本地持久化目录 | http = 连 Chroma 服务
CHROMA_MODE=embedded
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- RAG 参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=agent
MYSQL_PASSWORD=agent_password
MYSQL_DATABASE=after_sales_agent

# ---------- NO_PROXY（避免代理拦截本地服务）----------
NO_PROXY=127.0.0.1,localhost,::1
no_proxy=127.0.0.1,localhost,::1

# ---------- 相关性阈值 ----------
MIN_RELEVANCE_SCORE=0.55

# ========== OpenClaw 网关 ==========
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18000
OPENCLAW_API_KEY=local-rag-key
OPENCLAW_FEISHU_APP_ID=
OPENCLAW_FEISHU_APP_SECRET=
