# ============================================================
# Enterprise After-Sales Knowledge Base Agent Platform
# 环境变量模板 —— 复制为 .env 后按需填写
# ============================================================

# ---------- 应用 ----------
APP_NAME=Enterprise After-Sales Knowledge Base Agent Platform
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ---------- Ollama 本地模型 ----------
# 注意：必须用 127.0.0.1，不要用 localhost（IPv6 会连接失败）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_LLM_MODEL=qwen2.5-1.5b:latest

# ---------- 云端 API（可选，用于复杂问题兜底） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- LLM 路由策略 ----------
LLM_ROUTER_MODE=hybrid

# ---------- LangGraph ----------
LANGGRAPH_BASE_URL=http://127.0.0.1:8000
LANGGRAPH_API_KEY=local-dev-key
LANGGRAPH_STREAM_MODE=updates,custom

# ---------- LangSmith（可选） ----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=after-sales-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- RAG ----------
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=knowledge_base

EMBEDDING_MODEL=bge-m3:latest
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=agent_password
MYSQL_DATABASE=after_sales_agent

# ---------- OpenClaw ----------
OPENCLAW_GATEWAY_URL=http://127.0.0.1:3000
OPENCLAW_API_KEY=openclaw-dev-key
OPENCLAW_FEISHU_APP_ID=
OPENCLAW_FEISHU_APP_SECRET=
OPENCLAW_FEISHU_VERIFICATION_TOKEN=
OPENCLAW_FEISHU_ENCRYPT_KEY=

# ---------- Bridge ----------
BRIDGE_CALLBACK_PUBLIC_BASE_URL=http://127.0.0.1:3000
BRIDGE_DECISION_ONLY=true

# ---------- 工单系统（Mock） ----------
TICKET_API_BASE_URL=http://127.0.0.1:9000/api
TICKET_API_KEY=ticket-dev-key

# ---------- RAGAS 评估 ----------
RAGAS_ENABLED=false
RAGAS_SAMPLE_RATE=0.1
